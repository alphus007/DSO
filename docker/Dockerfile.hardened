# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 – Build / patch stage
# ─────────────────────────────────────────────────────────────────────────────
FROM wordpress:6.5-php8.3-apache AS builder

# Install WP-CLI to perform updates inside the image
RUN curl -sS https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
      -o /usr/local/bin/wp && \
    chmod +x /usr/local/bin/wp

# Remove default bundled plugins/themes that are rarely used and widen attack surface
RUN rm -rf /usr/src/wordpress/wp-content/plugins/hello.php \
           /usr/src/wordpress/wp-content/themes/twentytwentyone \
           /usr/src/wordpress/wp-content/themes/twentytwentytwo

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 – Hardened runtime image
# ─────────────────────────────────────────────────────────────────────────────
FROM wordpress:6.5-php8.3-apache

LABEL maintainer="devsecops-team"
LABEL version="1.0.0"
LABEL description="Hardened WordPress image – patched & security-configured"

# ── System hardening ──────────────────────────────────────────────────────────
# Update all system packages to pull security fixes
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    # Remove packages not needed at runtime
    apt-get purge -y \
      wget \
      netcat-traditional \
      telnet && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# ── PHP hardening (php.ini overrides) ─────────────────────────────────────────
RUN { \
    echo "expose_php = Off"; \
    echo "display_errors = Off"; \
    echo "display_startup_errors = Off"; \
    echo "log_errors = On"; \
    echo "error_log = /dev/stderr"; \
    echo "file_uploads = On"; \
    echo "upload_max_filesize = 10M"; \
    echo "post_max_size = 10M"; \
    echo "max_execution_time = 30"; \
    echo "disable_functions = exec,passthru,shell_exec,system,proc_open,popen,curl_multi_exec,parse_ini_file,show_source"; \
    echo "session.cookie_httponly = 1"; \
    echo "session.cookie_secure = 1"; \
    echo "session.use_strict_mode = 1"; \
    } > /usr/local/etc/php/conf.d/security.ini

# ── Apache hardening ──────────────────────────────────────────────────────────
RUN { \
    echo "ServerTokens Prod"; \
    echo "ServerSignature Off"; \
    echo "TraceEnable Off"; \
    echo "Header always set X-Frame-Options DENY"; \
    echo "Header always set X-Content-Type-Options nosniff"; \
    echo "Header always set X-XSS-Protection \"1; mode=block\""; \
    echo "Header always set Referrer-Policy \"strict-origin-when-cross-origin\""; \
    echo "Header always set Permissions-Policy \"geolocation=(), microphone=(), camera=()\""; \
    } > /etc/apache2/conf-available/security-hardening.conf && \
    a2enconf security-hardening && \
    a2enmod headers

# ── Copy patched WP core from builder ─────────────────────────────────────────
COPY --from=builder /usr/src/wordpress/wp-content /usr/src/wordpress/wp-content

# ── Non-root user setup ───────────────────────────────────────────────────────
# www-data already exists in the base image (uid 33); ensure correct perms
RUN chown -R www-data:www-data /usr/src/wordpress && \
    find /usr/src/wordpress -type d -exec chmod 755 {} \; && \
    find /usr/src/wordpress -type f -exec chmod 644 {} \;

# ── Drop extra SUID/SGID binaries ─────────────────────────────────────────────
RUN find / -perm /6000 -type f 2>/dev/null | \
    grep -Ev "(ping|su|sudo|newgrp|chsh|chfn|gpasswd|passwd|mount|umount)" | \
    xargs -r chmod a-s 2>/dev/null || true

# ── Hardened wp-config snippet ────────────────────────────────────────────────
COPY wp-config-hardening.php /usr/src/wordpress/wp-config-hardening.php

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY docker-entrypoint-hardened.sh /usr/local/bin/docker-entrypoint-hardened.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-hardened.sh

USER www-data
EXPOSE 80

ENTRYPOINT ["docker-entrypoint-hardened.sh"]
CMD ["apache2-foreground"]
